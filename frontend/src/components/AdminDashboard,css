/* =========================
   General App Styling
========================= */
body, html, #root {
  margin: 0;
  padding: 0;
  font-family: 'Roboto', sans-serif;
  background-color: #121212;
  color: #fff;
  height: 100%;
}

.App {
  display: flex;
  min-height: 100vh;
}

/* =========================
   Sidebar Styling
========================= */
.sidebar {
  width: 220px;
  background-color: #121212;
  display: flex;
  flex-direction: column;
  padding: 30px 20px;
  gap: 20px;
  border-right: 2px solid #FF6600;
}

.sidebar button {
  padding: 15px;
  font-size: 1.1rem;
  color: #FF6600;
  border: 2px solid #FF6600;
  border-radius: 12px;
  background: transparent;
  cursor: pointer;
  transition: all 0.3s ease;
}

.sidebar button:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* =========================
   Page Container
========================= */
.page-container {
  flex: 1;
  padding: 40px;
  overflow-y: auto;
}

/* =========================
   Headings
========================= */
h1, h2, h3 {
  color: #FF6600;
  margin-bottom: 20px;
}

/* =========================
   Forms (Add Project / Add Cert / Edit)
========================= */
.action-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 600px;
  margin: 0 auto;
  background-color: #1e1e1e;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 0 20px rgba(255,102,0,0.4);
}

.action-container input,
.action-container textarea,
.action-container select {
  padding: 12px;
  border-radius: 10px;
  border: 1px solid #FF6600;
  background-color: #121212;
  color: #fff;
  font-size: 1rem;
  width: 100%;
  outline: none;
  transition: all 0.3s ease;
}

.action-container input::placeholder,
.action-container textarea::placeholder {
  color: #aaa;
}

.action-container input:focus,
.action-container textarea:focus,
.action-container select:focus {
  border-color: #32CD32;
  box-shadow: 0 0 8px #32CD32;
}

/* =========================
   Buttons inside forms
========================= */
.action-btn {
  padding: 15px;
  font-size: 1.1rem;
  font-weight: bold;
  border: 2px solid #FF6600;
  background: transparent;
  color: #FF6600;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.action-btn:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* =========================
   List Cards (Projects / Certifications)
========================= */
.list-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

.list-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #1c1c1c;
  padding: 15px 20px;
  border-radius: 12px;
  border: 2px solid #FF6600;
}

.list-card img {
  max-width: 70px;
  border-radius: 5px;
  margin-right: 15px;
}

/* Buttons inside cards */
.list-card button {
  padding: 8px 15px;
  border-radius: 10px;
  border: 2px solid;
  background: transparent;
  cursor: pointer;
  transition: all 0.3s ease;
}

.list-card .edit-btn {
  border-color: #32CD32;
  color: #32CD32;
}

.list-card .edit-btn:hover {
  background-color: #32CD32;
  color: #121212;
  transform: scale(1.05);
}

.list-card .delete-btn {
  border-color: #FF6600;
  color: #FF6600;
}

.list-card .delete-btn:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* =========================
   Edit/Preview Box
========================= */
.edit-box {
  margin-top: 20px;
  padding: 20px;
  border: 2px solid #32CD32;
  border-radius: 12px;
  background-color: #1e1e1e;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.edit-box img {
  max-width: 200px;
  border-radius: 8px;
  margin-bottom: 10px;
}
