/* AdminDashboard.css */

/* Body & global */
body {
  margin: 0;
  font-family: 'Segoe UI', Roboto, sans-serif;
  background-color: #121212;
  color: #fff;
}

* {
  box-sizing: border-box;
}

/* Main container */
.admin-container {
  display: flex;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  width: 220px;
  background-color: #121212;
  border-right: 2px solid #FF6600;
  display: flex;
  flex-direction: column;
  padding: 20px;
  gap: 20px;
}

.sidebar button {
  padding: 15px;
  font-size: 1rem;
  font-weight: bold;
  color: #FF6600;
  background: transparent;
  border: 2px solid #FF6600;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.sidebar button:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* Page content */
.page-container {
  flex: 1;
  padding: 40px;
}

/* Welcome page */
.welcome-text {
  text-align: center;
  font-size: 2rem;
  margin-top: 100px;
}

/* Lists */
.list-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

.list-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  background-color: #1c1c1c;
  border-radius: 12px;
  border: 2px solid #FF6600;
}

.list-card img {
  max-width: 80px;
  border-radius: 8px;
}

/* Edit & Delete buttons */
.edit-btn, .delete-btn {
  padding: 8px 15px;
  border-radius: 10px;
  border: 2px solid;
  background: transparent;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.3s ease;
  margin-left: 10px;
}

.edit-btn {
  border-color: #32CD32;
  color: #32CD32;
}

.edit-btn:hover {
  background-color: #32CD32;
  color: #121212;
  transform: scale(1.05);
}

.delete-btn {
  border-color: #FF6600;
  color: #FF6600;
}

.delete-btn:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* Forms */
.form-container {
  margin-top: 25px;
  padding: 20px;
  border: 2px solid #32CD32;
  border-radius: 12px;
  max-width: 500px;
}

.form-container h3 {
  color: #FF6600;
  text-align: center;
  margin-bottom: 15px;
}

.form-container input[type="text"],
.form-container input[type="file"],
.form-container input[type="number"] {
  width: 100%;
  padding: 12px;
  margin-bottom: 12px;
  border-radius: 10px;
  border: none;
  background-color: #2c2c2c;
  color: #fff; /* White text for visibility */
}

.form-container input::placeholder {
  color: #ccc;
}

.form-container button {
  padding: 12px;
  width: 48%;
  border-radius: 10px;
  border: 2px solid #FF6600;
  background: transparent;
  color: #FF6600;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-right: 4%;
}

.form-container button:hover {
  background-color: #FF6600;
  color: #121212;
  transform: scale(1.05);
}

/* Cancel button overrides */
.form-container button.cancel-btn {
  border-color: #32CD32;
  color: #32CD32;
}

.form-container button.cancel-btn:hover {
  background-color: #32CD32;
  color: #121212;
}

/* AddProject & AddCert form container */
.add-form {
  margin-bottom: 30px;
}
